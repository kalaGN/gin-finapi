# 服务器配置：监听端口与运行环境；修改后重启生效。
SERVER_PORT=8082
ENV=production

# IP 限流配置：单进程每 IP 的请求次数与窗口，窗口使用 Go duration（如 1s）。
RATE_LIMIT_REQUESTS=5000
RATE_LIMIT_WINDOW=1s

# MongoDB 配置：连接、查询目标与连接池；超时使用 Go duration（如 5s）。
MONGODB_DSN=mongodb://localhost:27017
MONGODB_DATABASE=your_database_name
MONGODB_COLLECTION=data_20251101_0
MONGODB_TIMEOUT=5s
MONGODB_MAX_POOL=100
MONGODB_MIN_POOL=10

# Redis 配置：连接、每池连接数及超时（Go duration）；认证和映射各一池，API Key 与 secret 存储在 Redis。
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=1s

# 内存缓存配置：false 时直读 Redis；刷新周期不是 TTL，容量为 LRU 上限，回源并发限制始终生效；修改后重启。
REDIS_CACHE_ENABLED=true
REDIS_CACHE_REFRESH_INTERVAL=5m
REDIS_APIKEY_CACHE_MAX_ENTRIES=1000
REDIS_PRODUCT_AUTH_CACHE_MAX_ENTRIES=10000
REDIS_PRODUCT_MAP_CACHE_MAX_ENTRIES=1000
REDIS_CACHE_SYNC_CONCURRENCY=4

# 请求日志配置：file/redis 异步写完整载荷；队列条数/字节预算满则丢弃，Redis 失败重试2次；修改后重启。
REQUEST_LOG_OUTPUT=file
REQUEST_LOG_FILE=request.log
REQUEST_LOG_QUEUE_SIZE=10000
REQUEST_LOG_MAX_BYTES=67108864

# 独立计费日志 Redis：仅 redis 模式使用，地址必填；RPUSH request_log，不回退认证 Redis。
CHARGE_REDIS_ADDR=
CHARGE_REDIS_PASSWORD=
CHARGE_REDIS_DB=0
CHARGE_REDIS_POOL_SIZE=10
CHARGE_REDIS_TIMEOUT=1s
