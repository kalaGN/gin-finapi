# 服务器配置
SERVER_PORT=8082
ENV=production
SECRET_KEY=replace_with_a_strong_random_secret
API_KEY=replace_with_client_api_key

# 单进程按 IP 限流，修改后重启。次数必须为正整数，窗口使用 Go duration。
RATE_LIMIT_REQUESTS=5000
RATE_LIMIT_WINDOW=1s

# MongoDB 配置
MONGODB_DSN=mongodb://localhost:27017
MONGODB_DATABASE=your_database_name
MONGODB_COLLECTION=data_20251101_0
MONGODB_TIMEOUT=5s
MONGODB_MAX_POOL=100
MONGODB_MIN_POOL=10

# Redis 配置
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=1s
